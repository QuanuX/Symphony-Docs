  "keyFeatures": [
    "59-nanosecond tick-to-trade execution via isolated C++ core (Core 3 dead-core pinning)",
    "Python → Cython → C++ strategy pipeline with AI-assisted code generation",
    "C++ backtesting engine (Crucible) with L3 execution metrics and DuckDB integration",
    "Support for 20+ brokerages and prop firms via Rithmic, IBKR, Tradovate, and TopstepX",
    "Multi-node cluster management via quanuxctl CLI with NATS JetStream mesh",
    "Anaconda-first installation — first quant platform with an official Conda channel",
    "MCP server with agent skills for AI-assisted development and strategy iteration",
    "Hardware-enforced risk gate via L3 cache interlock (11.33ns time-to-halt)",
    "Figma-to-React code generation workflow via MCP server composition",
    "Sierra Chart DTC integration for professional charting and data feeds"
  ],
  "publicApiSurface": [
    "POST /api/auth/login",
    "POST /api/auth/register-client",
    "POST /api/foundry/forge",
    "POST /api/foundry/verify",
    "POST /api/strategy/backtest/run",
    "quanuxctl habitat equip <TARGET_GROUP>",
    "quanuxctl nest drop <TARGET_GROUP> --engine <ENGINE_TYPE>",
    "quanuxctl crucible start <strategy> [--version VERSION]",
    "quanuxctl crucible stop",
    "quanuxctl crucible status",
    "quanuxctl crucible report <strategy>",
    "quanuxctl topstepx user|password|apikey|env|install",
    "quanuxctl bridge status|run",
    "quanuxctl secrets get <KEY>",
    "python -m server.mcp.server (MCP Tool Authority)",
    "agent.skills.list (MCP)",
    "agent.skills.read(skill_name) (MCP)",
    "agent.skills.run_script(...) (MCP)",
    "conda install quanux (Anaconda channel)",
    "Extensions QXP pattern: QUANUX_BRIDGE_KEY env + go run main.go"
  ]
